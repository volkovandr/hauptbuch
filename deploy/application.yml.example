# Template for /etc/hauptbuch/application.yml on the Pi (root:hauptbuch, mode 0640 — see
# deploy/README.md). Overrides src/main/resources/application.yaml's dev defaults. Never commit
# the real file — it holds the DB password and, optionally, the Anthropic API key.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/hauptbuch
    username: hauptbuch
    password: CHANGE_ME

hauptbuch:
  # Database backups. `automatic` is off in the packaged defaults and turned on HERE, on the Pi:
  # a nightly pg_dump plus a catch-up if the Pi was off at 03:00. Manual backups taken from the
  # screen are never swept; automatic ones are kept to `keep-automatic`.
  # The directory sits under the data dir the systemd unit already lists in ReadWritePaths.
  # NOTE: a dump contains the settings row, and so the Anthropic API key — guard these files.
  backup:
    storage-root: /var/lib/hauptbuch/backups
    keep-automatic: 30
    automatic: true
    daily-cron: "0 0 3 * * *"
  receipts:
    storage-root: /var/lib/hauptbuch/receipts
  # The URL encoded in the landing page's "Open on your phone" QR panel. Leave it unset: the app
  # reads the address off the incoming request, honouring a gateway's X-Forwarded-Proto / -Host /
  # -Prefix, which is right for every normal deployment. Set it only when a gateway cannot be made
  # to send those headers, or the derived URL is otherwise wrong — it wins over the request.
  # public-base-url: http://homenet/pi/hauptbuch

# Optional (CLAUDE.md §1.8): only needed if you want the env fallback instead of setting the key
# via the masked Settings UI, which is the normal path and covers key rotation without a restart.
# Leave unset (or delete the line) to rely on the UI-stored key only.
# ANTHROPIC_API_KEY: CHANGE_ME
